{
  "workflow_name": "Daily Backup",
  "trigger": {
    "type": "schedule",
    "cron": "0 3 * * *"
  },
  "steps": [
    {
      "kind": "command",
      "name": "Backup Database",
      "detail": "mysqldump -u shop -p$DB_PASS shopdb > /tmp/shopdb_$DATE.sql"
    },
    {
      "kind": "email",
      "name": "Email Boss",
      "detail": "to boss@example.com subject Daily Backup ok"
    }
  ]
}